server {
    server_name 142.93.38.10 meliusrecovery.me www.meliusrecovery.me;

    root /var/Melius/frontend/dist;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

        location /api/ {
        proxy_pass http://0.0.0.0:5050;
        include /etc/nginx/proxy_params;
        proxy_redirect off;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/meliusrecovery.me/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/meliusrecovery.me/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot




}
server {
    if ($host = www.meliusrecovery.me) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = meliusrecovery.me) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name 142.93.38.10 meliusrecovery.me www.meliusrecovery.me;
    return 404; # managed by Certbot
}
